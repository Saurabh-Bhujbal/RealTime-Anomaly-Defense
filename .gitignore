# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual Environment
# =========================
.venv/
venv/
env/

# =========================
# IDE
# =========================
.vscode/
.idea/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# Model Checkpoints
# Ignore large/training checkpoints but track the inference model
# needed by the deployed backend.
# =========================
*.pth
*.pt
*.ckpt
# Force-track the production inference model
!models/baseline_cnn.pth

# =========================
# Dataset
# =========================
data/raw/*
data/processed/*

# =========================
# Logs
# =========================
*.log

# =========================
# Temporary
# =========================
*.tmp
*.temp

# =========================
# OS
# =========================
.DS_Store
Thumbs.db

# =========================
# Experiment outputs
# =========================
experiments/logs/*
experiments/results/*
experiments/figures/*

# =========================
# Frontend build output
# =========================
frontend/dist/
frontend/node_modules/

# =========================
# Backend env (keep .env.example, ignore real .env)
# =========================
backend/.env
!backend/.env.example

# =========================
# Frontend env (keep .env.production since it has no secrets)
# =========================
# frontend/.env.production is intentionally tracked