# Frontend production environment variables
# VITE_ prefix is required for Vite to expose variables to the browser bundle.
# This file is committed to git — do NOT put secrets here.
#
# In development: VITE_API_BASE_URL is empty → Vite dev proxy handles /api → localhost:8000
# In production : set this to your Render backend URL (no trailing slash)
VITE_API_BASE_URL=https://anomaly-defense-backend.onrender.com
